# Run configure-mec to fill the values marked AUTO_FROM_* from the bundled seed.
CSE_BASE_URL=http://127.0.0.1:3000
CSE_BASE_NAME=AUTO_FROM_SEED
CSE_RVI=AUTO_FROM_BUILD
AE_NAME=EdgeGuardMEC
AE_ID=YOUR_AE_ORIGINATOR

FCNT_DEVICE1_RI=AUTO_FROM_SEED
FCNT_DEVICE2_RI=AUTO_FROM_SEED
FCNT_DEVICE3_RI=AUTO_FROM_SEED
FCNT_DEVICE4_RI=AUTO_FROM_SEED
FCNT_DEVICE5_RI=AUTO_FROM_SEED
FCNT_RISK_RI=AUTO_FROM_SEED

TINYIOT_SERVER_TYPE=mn
TINYIOT_SERVER_IP=YOUR_MEC_LAN_IP
TINYIOT_SERVER_PORT=3000
TINYIOT_CSE_BASE_NAME=AUTO_FROM_SEED
TINYIOT_CSE_BASE_RI=AUTO_FROM_SEED
TINYIOT_CSE_BASE_SP_ID=AUTO_FROM_SEED

AI_AE_HOST=127.0.0.1
AI_AE_PORT=8001

# Remote IN-CSE on the Monitoring Node. Replace all placeholders before starting.
REMOTE_CSE_ID=YOUR_IN_CSE_ID
REMOTE_CSE_NAME=YOUR_IN_CSE_BASE_NAME
REMOTE_CSE_HOST=YOUR_MONITORING_NODE_ADDRESS
REMOTE_CSE_PORT=3001
