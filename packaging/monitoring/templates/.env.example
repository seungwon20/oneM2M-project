# Monitoring Node runtime settings. The IN-CSE base and RVI are compiled into this package.
IN_CSE_SERVER_IP=YOUR_MONITORING_NODE_ADDRESS
IN_CSE_SERVER_PORT=3001

PG_DASHBOARD_HOST=0.0.0.0
PG_DASHBOARD_PORT=8000
PG_DB_PATH=runtime/pinchguard.sqlite3
PG_INGEST_KEY=CHANGE_ME_TO_A_RANDOM_SECRET
PG_ENABLE_DEMO=0
PG_DEMO_SEED=0
PG_FRESH_SECONDS=15
PG_NOTIFY_TOKEN=

# Dashboard and IN-CSE run on this node; configure the remote MN-CSE ID from this package's build.
PG_IN_CSE_URL=http://127.0.0.1:3001
PG_MN_CSE_ID=AUTO_FROM_BUILD
PG_IN_CSE_ORIGIN=YOUR_DASHBOARD_ORIGINATOR
PG_IN_CSE_RVI=AUTO_FROM_BUILD
PG_IN_CSE_TIMEOUT=3
PG_MN_CSE_FRESH_SECONDS=30
PG_MN_CSE_POLL_SECONDS=10
