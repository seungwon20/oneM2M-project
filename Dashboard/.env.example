# Development only. Change in a shared environment.
PG_INGEST_KEY=local-dev-change-me
PG_ENABLE_DEMO=1
PG_DEMO_SEED=1
PG_FRESH_SECONDS=15
# Optional persistent storage file
# PG_DB_PATH=/data/pinchguard.sqlite3
# Optional notification protection (only works if CSE can send matching header)
# PG_NOTIFY_TOKEN=unique-value

# Optional direct pull from the team's remote MN-CSE (FastAPI server-side HTTP GET)
PG_MN_CSE_URL=http://172.19.17.34:3000
PG_MN_CSE_BASE=TinyIoT
PG_MN_CSE_CONTAINER=EdgeGuardMEC
PG_MN_CSE_ORIGIN=CAdmin
PG_MN_CSE_RVI=3
PG_MN_CSE_TIMEOUT=3
PG_MN_CSE_FRESH_SECONDS=30

# Automatic server-side MN-CSE polling interval (seconds)
PG_MN_CSE_POLL_SECONDS=10
