# Dashboard-only settings. Use a routable Monitoring Node address, not localhost,
# for the IN-CSE URL when the Dashboard runs on a separate computer.
PG_DB_PATH=runtime/pinchguard.sqlite3
PG_INGEST_KEY=CHANGE_ME_TO_A_RANDOM_SECRET
PG_ENABLE_DEMO=0
PG_DEMO_SEED=0
PG_FRESH_SECONDS=15
PG_NOTIFY_TOKEN=

# Dashboard and IN-CSE run on the same Monitoring Node in the default deployment.
PG_IN_CSE_URL=http://127.0.0.1:3001
PG_MN_CSE_ID=YOUR_TINYIOT_CSE_ID
PG_IN_CSE_ORIGIN=YOUR_DASHBOARD_ORIGINATOR
PG_IN_CSE_RVI=3
PG_IN_CSE_TIMEOUT=3
PG_MN_CSE_FRESH_SECONDS=30
PG_MN_CSE_POLL_SECONDS=10
