CSE_BASE_URL=http://127.0.0.1:3000
CSE_BASE_NAME=TinyIoT
CSE_RVI=3

AE_NAME=EdgeGuardMEC
AE_ID=YOUR_AE_ORIGINATOR

FCNT_DEVICE1_RI=YOUR_DEVICE1_RESOURCE_ID
FCNT_DEVICE2_RI=YOUR_DEVICE2_RESOURCE_ID
FCNT_DEVICE3_RI=YOUR_DEVICE3_RESOURCE_ID
FCNT_DEVICE4_RI=YOUR_DEVICE4_RESOURCE_ID
FCNT_DEVICE5_RI=YOUR_DEVICE5_RESOURCE_ID
FCNT_RISK_RI=YOUR_RISK_RESOURCE_ID

# TinyIoT MN-CSE build settings
TINYIOT_SERVER_TYPE=mn
# Advertised MEC POA address; use an address reachable from the Monitoring Node.
TINYIOT_SERVER_IP=YOUR_MEC_NODE_ADDRESS
TINYIOT_SERVER_PORT=3000
TINYIOT_CSE_BASE_NAME=TinyIoT
TINYIOT_CSE_BASE_RI=YOUR_TINYIOT_CSE_BASE_RI
TINYIOT_CSE_BASE_SP_ID=YOUR_TINYIOT_CSE_BASE_SP_ID

# MEC -> Monitoring Node Remote CSE registration settings
REMOTE_CSE_ID=/YOUR_IN_CSE_ID
REMOTE_CSE_NAME=YOUR_IN_CSE_NAME
REMOTE_CSE_HOST=YOUR_MONITORING_NODE_ADDRESS
REMOTE_CSE_PORT=3001

# Monitoring Node IN-CSE build settings
IN_CSE_SERVER_IP=YOUR_MONITORING_NODE_ADDRESS
IN_CSE_SERVER_PORT=3001
IN_CSE_CSE_BASE_NAME=YOUR_IN_CSE_BASE_NAME
IN_CSE_CSE_BASE_RI=YOUR_IN_CSE_BASE_RI
IN_CSE_CSE_BASE_SP_ID=YOUR_CSE_SP_ID
IN_CSE_RVI=3
# Optional development-only privileged Originator; leave empty for package builds.
IN_CSE_ADMIN_AE_ID=
IN_CSE_ALLOWED_REMOTE_CSE_ID=YOUR_ALLOWED_CSE_IDS

# Dashboard and IN-CSE run on the same Monitoring Node in the default deployment.
PG_IN_CSE_URL=http://127.0.0.1:3001
PG_MN_CSE_ID=YOUR_TINYIOT_CSE_ID
PG_IN_CSE_ORIGIN=YOUR_DASHBOARD_ORIGINATOR
PG_IN_CSE_RVI=3